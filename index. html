<!DOCTYPE html>
<html lang="tg">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Gamer Donat Store</title>
    <script src="https://telegram.org/js/telegram-web-app.js"></script>
    <style>
        :root {
            --bg-color: #121214;
            --card-bg: #1e1e24;
            --accent-color: #0088cc;
            --accent-hover: #00a0e9;
            --text-main: #ffffff;
            --text-sub: #a1a1aa;
            --border-color: #2e2e38;
        }

        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
            background-color: var(--bg-color);
            color: var(--text-main);
            margin: 0;
            padding: 16px;
            box-sizing: border-box;
        }

        h2 {
            text-align: center;
            font-size: 20px;
            margin-bottom: 20px;
        }

        .tabs {
            display: flex;
            gap: 10px;
            margin-bottom: 20px;
        }

        .tab-btn {
            flex: 1;
            padding: 12px;
            border: 1px solid var(--border-color);
            background: var(--card-bg);
            color: var(--text-main);
            border-radius: 10px;
            font-weight: bold;
            cursor: pointer;
            transition: 0.2s;
        }

        .tab-btn.active {
            border-color: var(--accent-color);
            background: var(--accent-color);
        }

        .section {
            display: none;
        }

        .section.active {
            display: block;
        }

        .grid {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 12px;
            margin-bottom: 20px;
        }

        .card {
            background: var(--card-bg);
            border: 1px solid var(--border-color);
            border-radius: 12px;
            padding: 14px;
            text-align: center;
            cursor: pointer;
            transition: 0.2s;
        }

        .card.selected {
            border-color: var(--accent-color);
            box-shadow: 0 0 10px rgba(0, 136, 204, 0.4);
        }

        .card-title {
            font-size: 16px;
            font-weight: bold;
            margin-bottom: 6px;
        }

        .card-price {
            color: var(--text-sub);
            font-size: 14px;
        }

        .form-group {
            margin-bottom: 20px;
        }

        label {
            display: block;
            margin-bottom: 8px;
            font-size: 14px;
            color: var(--text-sub);
        }

        input {
            width: 100%;
            padding: 12px;
            border-radius: 10px;
            border: 1px solid var(--border-color);
            background: var(--card-bg);
            color: var(--text-main);
            box-sizing: border-box;
            font-size: 16px;
            outline: none;
        }

        input:focus {
            border-color: var(--accent-color);
        }

        .submit-btn {
            width: 100%;
            padding: 14px;
            background: var(--accent-color);
            border: none;
            border-radius: 10px;
            color: white;
            font-size: 16px;
            font-weight: bold;
            cursor: pointer;
        }

        .submit-btn:disabled {
            background: #444;
            cursor: not-allowed;
        }
    </style>
</head>
<body>

    <h2>🎮 Мағозаи Донат</h2>

    <div class="tabs">
        <button class="tab-btn active" onclick="switchTab('freefire')">🔥 Free Fire</button>
        <button class="tab-btn" onclick="switchTab('pubg')">🎯 PUBG Mobile</button>
    </div>

    <div id="freefire" class="section active">
        <div class="grid">
            <div class="card" onclick="selectPack('Free Fire 100 💎', '15 сомонӣ', this)">
                <div class="card-title">100 💎</div>
                <div class="card-price">15 сомонӣ</div>
            </div>
            <div class="card" onclick="selectPack('Free Fire 310 💎', '40 сомонӣ', this)">
                <div class="card-title">310 💎</div>
                <div class="card-price">40 сомонӣ</div>
            </div>
            <div class="card" onclick="selectPack('Free Fire 520 💎', '65 сомонӣ', this)">
                <div class="card-title">520 💎</div>
                <div class="card-price">65 сомонӣ</div>
            </div>
            <div class="card" onclick="selectPack('Ваучер (Неделя)', '25 сомонӣ', this)">
                <div class="card-title">Ваучер (Ҳафта)</div>
                <div class="card-price">25 сомонӣ</div>
            </div>
        </div>
    </div>

    <div id="pubg" class="section">
        <div class="grid">
            <div class="card" onclick="selectPack('PUBG 60 UC', '14 сомонӣ', this)">
                <div class="card-title">60 UC</div>
                <div class="card-price">14 сомонӣ</div>
            </div>
            <div class="card" onclick="selectPack('PUBG 325 UC', '68 сомонӣ', this)">
                <div class="card-title">325 UC</div>
                <div class="card-price">68 сомонӣ</div>
            </div>
            <div class="card" onclick="selectPack('PUBG 660 UC', '135 сомонӣ', this)">
                <div class="card-title">660 UC</div>
                <div class="card-price">135 сомонӣ</div>
            </div>
        </div>
    </div>

    <div class="form-group">
        <label for="player-id">🆔 Player ID (UID):</label>
        <input type="number" id="player-id" placeholder="ID-и худро ворид кунед...">
    </div>

    <button class="submit-btn" id="send-btn" onclick="sendData()" disabled>Заказро тасдиқ кунед</button>

    <script>
        const tg = window.Telegram.WebApp;
        tg.expand();

        let selectedPackName = "";
        let selectedPackPrice = "";

        function switchTab(tabId) {
            document.querySelectorAll('.section').forEach(s => s.classList.remove('active'));
            document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
            
            document.getElementById(tabId).classList.add('active');
            event.target.classList.add('active');
            
            clearSelection();
        }

        function clearSelection() {
            document.querySelectorAll('.card').forEach(c => c.classList.remove('selected'));
            selectedPackName = "";
            selectedPackPrice = "";
            validateForm();
        }

        function selectPack(name, price, element) {
            document.querySelectorAll('.card').forEach(c => c.classList.remove('selected'));
            element.classList.add('selected');
            
            selectedPackName = name;
            selectedPackPrice = price;
            
            validateForm();
        }

        document.getElementById('player-id').addEventListener('input', validateForm);

        function validateForm() {
            const playerId = document.getElementById('player-id').value.trim();
            const btn = document.getElementById('send-btn');
            
            if (selectedPackName !== "" && playerId.length >= 5) {
                btn.disabled = false;
            } else {
                btn.disabled = true;
            }
        }

        function sendData() {
            const playerId = document.getElementById('player-id').value.trim();
            const data = {
                pack: selectedPackName,
                price: selectedPackPrice,
                id: playerId
            };

            tg.sendData(JSON.stringify(data));
            tg.close();
        }
    </script>
</body>
</html>
